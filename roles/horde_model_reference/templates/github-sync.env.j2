# {{ ansible_managed }}
# horde-model-reference GitHub sync sidecar environment — rendered by Ansible
# Permissions: 0600 root:root

# ── PRIMARY source ──────────────────────────────────────────────────────────────
# NOTE: must include the /api suffix (routes are mounted under /api).
HORDE_GITHUB_SYNC_PRIMARY_API_URL={{ horde_model_reference_github_sync_primary_api_url }}

# ── Sync behaviour ──────────────────────────────────────────────────────────────
HORDE_GITHUB_SYNC_WATCH_INTERVAL_SECONDS={{ horde_model_reference_github_sync_watch_interval_seconds }}
HORDE_GITHUB_SYNC_MIN_CHANGES_THRESHOLD={{ horde_model_reference_github_sync_min_changes_threshold }}
HORDE_GITHUB_SYNC_PR_LABELS={{ (horde_model_reference_github_sync_pr_labels.split(',') | map('trim') | list) | to_json }}
{% if horde_model_reference_github_sync_pr_reviewers | length > 0 %}
HORDE_GITHUB_SYNC_PR_REVIEWERS={{ (horde_model_reference_github_sync_pr_reviewers.split(',') | map('trim') | list) | to_json }}
{% endif %}

# ── Target repositories (owner override enables fork-based testing) ──────────────
HORDE_MODEL_REFERENCE_IMAGE_GITHUB_REPO__OWNER={{ horde_model_reference_github_sync_image_repo_owner }}
HORDE_MODEL_REFERENCE_IMAGE_GITHUB_REPO__NAME={{ horde_model_reference_github_sync_image_repo_name }}
HORDE_MODEL_REFERENCE_IMAGE_GITHUB_REPO__BRANCH={{ horde_model_reference_github_sync_image_repo_branch }}
HORDE_MODEL_REFERENCE_TEXT_GITHUB_REPO__OWNER={{ horde_model_reference_github_sync_text_repo_owner }}
HORDE_MODEL_REFERENCE_TEXT_GITHUB_REPO__NAME={{ horde_model_reference_github_sync_text_repo_name }}
HORDE_MODEL_REFERENCE_TEXT_GITHUB_REPO__BRANCH={{ horde_model_reference_github_sync_text_repo_branch }}

# ── GitHub authentication ───────────────────────────────────────────────────────
{% if horde_model_reference_github_sync_github_token | length > 0 %}
HORDE_GITHUB_SYNC_GITHUB_TOKEN={{ horde_model_reference_github_sync_github_token }}
{% endif %}
{% if horde_model_reference_github_app_id | string | length > 0 %}
GITHUB_APP_ID={{ horde_model_reference_github_app_id }}
{% if horde_model_reference_github_app_installation_id | string | length > 0 %}
GITHUB_APP_INSTALLATION_ID={{ horde_model_reference_github_app_installation_id }}
{% endif %}
GITHUB_APP_PRIVATE_KEY_PATH=/app/github-app-key.pem
{% endif %}

# ── Git identity for automated commits ──────────────────────────────────────────
GIT_AUTHOR_NAME=Horde Model Reference Bot
GIT_AUTHOR_EMAIL=bot@horde-model-reference.local
GIT_COMMITTER_NAME=Horde Model Reference Bot
GIT_COMMITTER_EMAIL=bot@horde-model-reference.local
