# {{ ansible_managed }}
# AI Horde service-alerts environment — rendered by Ansible.
# Permissions: 0600 root:root (contains secrets).

HORDE_ALERTS_HOST=0.0.0.0
HORDE_ALERTS_PORT={{ horde_service_alerts_port }}
HORDE_ALERTS_LOG_LEVEL={{ horde_service_alerts_log_level }}

HORDE_ALERTS_ALERTMANAGER_BASE_URL={{ horde_service_alerts_alertmanager_base_url }}
HORDE_ALERTS_MIMIR_BASE_URL={{ horde_service_alerts_mimir_base_url }}
HORDE_ALERTS_MIMIR_TENANT_DEFAULT={{ horde_service_alerts_mimir_tenant_default }}
HORDE_ALERTS_MIMIR_CURATED_QUERIES={{ horde_service_alerts_mimir_curated_queries | to_json }}

{% if horde_service_alerts_upstream_basic_auth_user | length > 0 %}
HORDE_ALERTS_UPSTREAM_BASIC_AUTH_USER={{ horde_service_alerts_upstream_basic_auth_user }}
HORDE_ALERTS_UPSTREAM_BASIC_AUTH_PASSWORD={{ horde_service_alerts_upstream_basic_auth_password }}
{% endif %}

HORDE_ALERTS_AIHORDE_BASE_URL={{ horde_service_alerts_aihorde_base_url }}
HORDE_ALERTS_AIHORDE_CLIENT_AGENT={{ horde_service_alerts_aihorde_client_agent }}
HORDE_ALERTS_MODERATOR_CACHE_TTL_SECONDS={{ horde_service_alerts_moderator_cache_ttl_seconds }}
HORDE_ALERTS_MODERATOR_CACHE_NEGATIVE_TTL_SECONDS={{ horde_service_alerts_moderator_cache_negative_ttl_seconds }}
HORDE_ALERTS_MODERATOR_CACHE_MAX_ENTRIES={{ horde_service_alerts_moderator_cache_max_entries }}

HORDE_ALERTS_PUBLIC_ALERT_LABEL_ALLOWLIST={{ horde_service_alerts_public_alert_label_allowlist | to_json }}
HORDE_ALERTS_PUBLIC_ANNOTATION_ALLOWLIST={{ horde_service_alerts_public_annotation_allowlist | to_json }}

HORDE_ALERTS_REQUEST_TIMEOUT_SECONDS={{ horde_service_alerts_request_timeout_seconds }}
HORDE_ALERTS_CORS_ALLOW_ORIGINS={{ horde_service_alerts_cors_allow_origins | to_json }}
HORDE_ALERTS_ENABLE_INTERNAL_SWAGGER_DOCS={{ horde_service_alerts_enable_internal_swagger_docs | string | lower }}

{% for key, value in horde_service_alerts_env_overrides.items() %}
{{ key }}={{ value }}
{% endfor %}
