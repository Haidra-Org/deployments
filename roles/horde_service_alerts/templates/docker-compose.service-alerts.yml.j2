# {{ ansible_managed }}
{# Compose image ref: append @<digest> when set, otherwise use the bare ref. #}
{%- set _image_ref = horde_service_alerts_image
                     ~ ('@' ~ horde_service_alerts_image_digest
                        if (horde_service_alerts_image_digest | default('') | length) > 0
                        else '') -%}
services:
  service-alerts:
    image: {{ _image_ref }}
    container_name: {{ horde_service_alerts_container_name }}
    restart: unless-stopped
    labels:
      horde.logs: "true"
      horde.app: "ai-horde-service-alerts"
      horde.component: "public-api"
    ports:
      - "{{ horde_service_alerts_listen }}:{{ horde_service_alerts_port }}:{{ horde_service_alerts_port }}"
    env_file:
      - {{ horde_service_alerts_base_dir }}/.env
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test:
        - CMD
        - python
        - "-c"
        - "import urllib.request; urllib.request.urlopen('http://localhost:{{ horde_service_alerts_port }}/healthz')"
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: {{ horde_service_alerts_log_driver }}
{% if horde_service_alerts_log_driver == 'journald' %}
      options:
        tag: "{{ horde_service_alerts_log_tag }}"
{% endif %}
