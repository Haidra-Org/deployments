# Grafana Tempo configuration - monolithic mode with S3-compatible object storage
# Managed by Ansible - do not edit manually

stream_over_http_enabled: true

server:
  http_listen_port: {{ horde_monitoring_tempo_http_port }}
  log_level: {{ horde_monitoring_tempo_log_level }}
  grpc_server_max_recv_msg_size: 104857600
  grpc_server_max_send_msg_size: 104857600

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "{{ horde_monitoring_tempo_otlp_bind_address }}:{{ horde_monitoring_tempo_otlp_grpc_port }}"
        http:
          endpoint: "{{ horde_monitoring_tempo_otlp_bind_address }}:{{ horde_monitoring_tempo_otlp_http_port }}"

ingester:
  trace_idle_period: {{ horde_monitoring_tempo_ingester_trace_idle_period }}
  max_block_bytes: {{ horde_monitoring_tempo_ingester_max_block_bytes }}
  max_block_duration: {{ horde_monitoring_tempo_ingester_max_block_duration }}

querier:
  max_concurrent_queries: {{ horde_monitoring_tempo_max_concurrent_queries }}

query_frontend:
  trace_by_id:
    concurrent_shards: {{ horde_monitoring_tempo_trace_concurrent_shards }}
  search:
    concurrent_jobs: {{ horde_monitoring_tempo_search_concurrent_jobs }}

compactor:
  compaction:
    block_retention: {{ horde_monitoring_tempo_trace_retention }}

{% if horde_monitoring_tempo_cache_roles | length > 0 %}
cache:
  caches:
    - roles:
{% for role in horde_monitoring_tempo_cache_roles %}
        - {{ role | to_json }}
{% endfor %}
      memcached:
        addresses: {{ horde_monitoring_tempo_cache_memcached_addresses | to_json }}
        timeout: {{ horde_monitoring_tempo_cache_memcached_timeout }}
        max_idle_conns: {{ horde_monitoring_tempo_cache_memcached_max_idle_conns }}
        max_item_size: {{ horde_monitoring_tempo_cache_memcached_max_item_size }}
        ttl: {{ horde_monitoring_tempo_cache_ttl }}
{% endif %}

{% if horde_monitoring_mimir_enable_s3 | bool %}
storage:
  trace:
    pool:
      max_workers: {{ horde_monitoring_tempo_backend_max_workers }}
      queue_depth: {{ horde_monitoring_tempo_backend_queue_depth }}
    backend: s3
    s3:
      endpoint: {{ horde_monitoring_s3_endpoint }}
      access_key: {{ horde_monitoring_s3_access_key }}
      secret_key: {{ horde_monitoring_s3_secret_key }}
      bucket: {{ horde_monitoring_tempo_traces_bucket }}
      insecure: {{ horde_monitoring_s3_insecure | bool | lower }}
      forcepathstyle: {{ horde_monitoring_s3_force_path_style | bool | lower }}
      region: {{ horde_monitoring_s3_region }}
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks
{% else %}
storage:
  trace:
    pool:
      max_workers: {{ horde_monitoring_tempo_backend_max_workers }}
      queue_depth: {{ horde_monitoring_tempo_backend_queue_depth }}
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks
{% endif %}

{% if horde_monitoring_tempo_metrics_generator_enabled | bool %}
metrics_generator:
  ring:
    kvstore:
      store: inmemory
  processor:
    service_graphs:
      dimensions: []
    span_metrics:
      dimensions: []
    local_blocks:
      filter_server_spans: false
      flush_to_storage: true
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://mimir:9009/api/v1/push
        headers:
          X-Scope-OrgID: {{ horde_monitoring_tempo_metrics_generator_tenant_id }}
        send_exemplars: true
  traces_storage:
    path: /var/tempo/generator/traces

overrides:
  defaults:
    metrics_generator:
      processors:
{% for processor in horde_monitoring_tempo_metrics_generator_processors %}
        - {{ processor }}
{% endfor %}
{% endif %}

usage_report:
  reporting_enabled: false
