# Grafana datasource provisioning - Mimir, Loki, Tempo
# Managed by Ansible - do not edit manually

apiVersion: 1

{% set public_loki = horde_monitoring_grafana_anonymous_enabled | bool and horde_monitoring_install_loki | bool and horde_monitoring_grafana_public_loki_enabled | bool %}
{% set public_tempo = horde_monitoring_grafana_anonymous_enabled | bool and horde_monitoring_install_tempo | bool and horde_monitoring_grafana_public_tempo_enabled | bool %}
{% set public_pyroscope = horde_monitoring_grafana_anonymous_enabled | bool and horde_monitoring_install_pyroscope | bool and horde_monitoring_grafana_public_pyroscope_enabled | bool %}
{# Explicit cleanup also removes datasources provisioned by earlier versions.
   Scope deletion to the public org; internal authenticated access is retained. #}
{% if not (public_loki and public_tempo and public_pyroscope) %}
deleteDatasources:
{% if not public_loki %}
  - name: Loki ({{ horde_monitoring_public_datasource_name }})
    orgId: {{ horde_monitoring_grafana_public_org_id }}
{% endif %}
{% if not public_tempo %}
  - name: Tempo
    orgId: {{ horde_monitoring_grafana_public_org_id }}
{% endif %}
{% if not public_pyroscope %}
  - name: Pyroscope ({{ horde_monitoring_public_datasource_name }})
    orgId: {{ horde_monitoring_grafana_public_org_id }}
{% endif %}
{% else %}
deleteDatasources: []
{% endif %}

datasources:
  # --- Org 1 (admin) datasources ---
  - name: {{ horde_monitoring_application_datasource_name }}
    uid: mimir-app
    orgId: 1
    type: prometheus
    access: proxy
    url: http://mimir:9009/prometheus
    isDefault: true
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_application_tenant_id }}
  - name: {{ horde_monitoring_infrastructure_datasource_name }}
    uid: mimir-infra
    orgId: 1
    type: prometheus
    access: proxy
    url: http://mimir:9009/prometheus
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_infrastructure_tenant_id }}
  - name: {{ horde_monitoring_telemetry_datasource_name }}
    uid: mimir-telemetry
    orgId: 1
    type: prometheus
    access: proxy
    url: http://mimir:9009/prometheus
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_telemetry_tenant_id }}
{% if horde_monitoring_alertmanager_url %}
  - name: Alertmanager
    uid: alertmanager
    orgId: 1
    type: alertmanager
    access: proxy
    url: {{ horde_monitoring_alertmanager_url }}
    isDefault: false
    editable: false
    jsonData:
      implementation: prometheus
      handleGrafanaManagedAlerts: false
{% endif %}
{% if horde_monitoring_install_loki | bool %}
  - name: Loki ({{ horde_monitoring_application_datasource_name }})
    uid: loki-app
    orgId: 1
    type: loki
    access: proxy
    url: http://loki:{{ horde_monitoring_loki_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
      derivedFields:
{% if horde_monitoring_install_tempo | bool %}
        - datasourceUid: tempo
          matcherRegex: "(?:trace_id|traceID|traceId)=(\\w+)"
          name: TraceID
          url: "$${__value.raw}"
{% endif %}
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_application_tenant_id }}
  - name: Loki ({{ horde_monitoring_infrastructure_datasource_name }})
    uid: loki-infra
    orgId: 1
    type: loki
    access: proxy
    url: http://loki:{{ horde_monitoring_loki_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
      derivedFields:
{% if horde_monitoring_install_tempo | bool %}
        - datasourceUid: tempo
          matcherRegex: "(?:trace_id|traceID|traceId)=(\\w+)"
          name: TraceID
          url: "$${__value.raw}"
{% endif %}
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_infrastructure_tenant_id }}
{% endif %}
{% if horde_monitoring_install_tempo | bool %}
  - name: Tempo
    uid: tempo
    orgId: 1
    type: tempo
    access: proxy
    url: http://tempo:{{ horde_monitoring_tempo_http_port }}
    isDefault: false
    editable: false
    jsonData:
      tracesToLogsV2:
{% if horde_monitoring_install_loki | bool %}
        datasourceUid: loki-app
        filterByTraceID: true
        filterBySpanID: true
{% endif %}
      tracesToMetrics:
        datasourceUid: mimir-telemetry
      serviceMap:
        datasourceUid: mimir-telemetry
      nodeGraph:
        enabled: true
{% endif %}
{% if horde_monitoring_install_pyroscope | bool %}
  - name: Pyroscope ({{ horde_monitoring_application_datasource_name }})
    uid: pyroscope-app
    orgId: 1
    type: grafana-pyroscope-datasource
    access: proxy
    url: http://pyroscope:{{ horde_monitoring_pyroscope_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_application_tenant_id }}
  - name: Pyroscope ({{ horde_monitoring_infrastructure_datasource_name }})
    uid: pyroscope-infra
    orgId: 1
    type: grafana-pyroscope-datasource
    access: proxy
    url: http://pyroscope:{{ horde_monitoring_pyroscope_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_infrastructure_tenant_id }}
{% endif %}
{% if horde_monitoring_grafana_anonymous_enabled | bool and horde_monitoring__public_org_exists | default(false) | bool %}
  # --- Org 2 (public / anonymous) datasource ---
  - name: {{ horde_monitoring_public_datasource_name }}
    uid: mimir-public
    orgId: {{ horde_monitoring_grafana_public_org_id }}
    type: prometheus
    access: proxy
    url: http://mimir:9009/prometheus
    isDefault: true
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_public_tenant_id }}
{% if public_loki %}
  - name: Loki ({{ horde_monitoring_public_datasource_name }})
    uid: loki-public
    orgId: {{ horde_monitoring_grafana_public_org_id }}
    type: loki
    access: proxy
    url: http://loki:{{ horde_monitoring_loki_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_public_tenant_id }}
{% endif %}
{% if public_tempo %}
  - name: Tempo
    uid: tempo-public
    orgId: {{ horde_monitoring_grafana_public_org_id }}
    type: tempo
    access: proxy
    url: http://tempo:{{ horde_monitoring_tempo_http_port }}
    isDefault: false
    editable: false
    jsonData:
{% if public_loki %}
      tracesToLogsV2:
        datasourceUid: loki-public
        filterByTraceID: true
        filterBySpanID: true
{% endif %}
      tracesToMetrics:
        datasourceUid: mimir-public
      serviceMap:
        datasourceUid: mimir-public
      nodeGraph:
        enabled: true
{% endif %}
{% if public_pyroscope %}
  - name: Pyroscope ({{ horde_monitoring_public_datasource_name }})
    uid: pyroscope-public
    orgId: {{ horde_monitoring_grafana_public_org_id }}
    type: grafana-pyroscope-datasource
    access: proxy
    url: http://pyroscope:{{ horde_monitoring_pyroscope_port }}
    isDefault: false
    editable: false
    jsonData:
      httpHeaderName1: X-Scope-OrgID
    secureJsonData:
      httpHeaderValue1: {{ horde_monitoring_public_tenant_id }}
{% endif %}
{% endif %}
